# fragments output
components:
  schemas:
    Order:
      type: object
      properties:
        id:
          type: integer
          format: int64
          minimum: 0
        total_cents:
          type: integer
          format: int64
          minimum: 0
      required:
      - id
      - total_cents
      description: An order.
    OrderEvent:
      type: object
      oneOf:
      - $ref: "#/components/schemas/OrderEventPlaced"
      - $ref: "#/components/schemas/OrderEventCancelled"
      discriminator:
        propertyName: type
        mapping:
          placed: "#/components/schemas/OrderEventPlaced"
          cancelled: "#/components/schemas/OrderEventCancelled"
      description: What changed.
    OrderEventCancelled:
      type: object
      properties:
        type:
          type: string
          enum:
          - cancelled
          description: "Discriminator: cancelled"
        id:
          type: integer
          format: int64
          minimum: 0
        reason:
          type:
          - string
          - "null"
      required:
      - type
      - id
      - reason
    OrderEventPlaced:
      type: object
      properties:
        type:
          type: string
          enum:
          - placed
          description: "Discriminator: placed"
        order:
          $ref: "#/components/schemas/Order"
      required:
      - type
      - order
