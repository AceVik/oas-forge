      - id: 1
        login: ada
      deprecated: true
    Event:
      type: object
      oneOf:
      - $ref: "#/components/schemas/EventCreated"
      - $ref: "#/components/schemas/EventRenamed"
      discriminator:
        propertyName: type
        mapping:
          Created: "#/components/schemas/EventCreated"
          Renamed: "#/components/schemas/EventRenamed"
      description: An event.
    EventCreated:
      type: object
      properties:
        type:
          type: string
          enum:
          - Created
          description: "Discriminator: Created"
        id:
          type: integer
          format: int64
          minimum: 0
          maximum: 4294967295
