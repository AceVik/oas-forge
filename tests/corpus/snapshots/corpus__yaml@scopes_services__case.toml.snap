---
source: tests/corpus/main.rs
expression: text
input_file: tests/corpus/cases/scopes_services/case.toml
---
# full output of scope public
openapi: "3.1.0"
info:
  title: Gateway
  version: "1.0.0"
servers:
- url: https://api.example.com
paths:
  /health:
    get:
      summary: Gateway health
      operationId: gateway_health
      security: []
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/GatewayHealth"
  "/users/{id}":
    get:
      summary: Get a user
      operationId: get_user
      tags:
      - Users
      parameters:
      - name: id
        in: path
        required: true
        schema:
          type: integer
          format: int64
          minimum: 0
      security:
      - bearer: []
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/User"
        "404":
          description: No such user
          content:
            application/problem+json:
              schema:
                $ref: "#/components/schemas/ProblemDetails"
  /reports:
    post:
      summary: Report a user
      operationId: report_user
      tags:
      - Reports
      security:
      - bearer: []
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/Report"
        required: true
      responses:
        "202":
          description: Accepted
components:
  schemas:
    GatewayHealth:
      type: object
      properties:
        ok:
          type: boolean
      required:
      - ok
      description: The state of the gateway.
    ProblemDetails:
      type: object
      description: Problem details (RFC 9457).
      properties:
        type:
          type: string
          format: uri-reference
          default: about:blank
          description: A URI reference that identifies the problem type.
        title:
          type: string
          description: A short summary of the problem type.
        status:
          type: integer
          format: int32
          minimum: 100
          maximum: 599
          description: The HTTP status code.
        detail:
          type: string
          description: An explanation specific to this occurrence.
        instance:
          type: string
          format: uri-reference
          description: A URI reference that identifies this occurrence.
    Report:
      type: object
      properties:
        id:
          type: integer
          format: int64
          minimum: 0
        user:
          type: integer
          format: int64
          minimum: 0
        reason:
          type: string
      required:
      - id
      - user
      - reason
      description: A report about a user.
    User:
      type: object
      properties:
        id:
          type: integer
          format: int64
          minimum: 0
        name:
          type: string
      required:
      - id
      - name
      description: A user account.
  securitySchemes:
    admin_token:
      type: apiKey
      in: header
      name: X-Admin-Token
    bearer:
      type: http
      scheme: bearer
tags:
- name: Users
  description: Accounts
- name: Reports
  description: Reports about accounts
# full output of scope admin
openapi: "3.1.0"
info:
  title: Gateway administration
  version: "1.0.0"
servers:
- url: http://127.0.0.1:9000
paths:
  /reports:
    get:
      summary: List reports
      operationId: list_reports
      security:
      - admin_token: []
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Report"
  "/users/{id}":
    delete:
      summary: Delete a user
      operationId: delete_user
      parameters:
      - name: id
        in: path
        required: true
        schema:
          type: integer
          format: int64
          minimum: 0
      security:
      - admin_token: []
      responses:
        "204":
          description: No Content
components:
  schemas:
    Report:
      type: object
      properties:
        id:
          type: integer
          format: int64
          minimum: 0
        user:
          type: integer
          format: int64
          minimum: 0
        reason:
          type: string
      required:
      - id
      - user
      - reason
      description: A report about a user.
  securitySchemes:
    admin_token:
      type: apiKey
      in: header
      name: X-Admin-Token
    bearer:
      type: http
      scheme: bearer
# full output of scope feedback
openapi: "3.1.0"
info:
  title: Feedback
  version: "2.0.0"
paths:
  /health:
    get:
      summary: Feedback health
      operationId: feedback_health
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FeedbackHealth"
  /feedback:
    post:
      summary: Send feedback
      operationId: send_feedback
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/Feedback"
        required: true
      responses:
        "204":
          description: No Content
  /reports:
    get:
      summary: Feedback received as reports
      operationId: feedback_reports
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Feedback"
components:
  schemas:
    Feedback:
      type: object
      properties:
        text:
          type: string
        rating:
          type: integer
          format: int32
          minimum: 0
          maximum: 255
      required:
      - text
      - rating
      description: Feedback about the service.
    FeedbackHealth:
      type: object
      properties:
        ok:
          type: boolean
        queued:
          type: integer
          format: int64
          minimum: 0
          maximum: 4294967295
      required:
      - ok
      - queued
      description: The state of the feedback service.
  securitySchemes:
    admin_token:
      type: apiKey
      in: header
      name: X-Admin-Token
    bearer:
      type: http
      scheme: bearer
