    User:
      type: object
      properties:
        id:
          type: integer
          format: int64
          minimum: 0
      required:
      - id
      description: A user.
    UserFilter:
      type: object
      properties:
        nameContains:
          type:
          - string
          - "null"
          description: Text in the name.
      allOf:
      - $ref: "#/components/schemas/Paging"
      - anyOf:
        - $ref: "#/components/schemas/Sorting"
        - {}
      description: Filters for listing users.
    UserPath:
      type: object
      properties:
        org:
          type: string
        id:
          type: integer
          format: int64
          minimum: 0
      required:
