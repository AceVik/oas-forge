# full output
openapi: "3.1.0"
info:
  title: Tenants
  version: "1.0.0"
paths:
  "/tenants/{tenant}/users":
    get:
      summary: List users
      operationId: list_users
      tags:
      - Tenants
      parameters:
      - name: tenant
        in: path
        required: true
        description: Tenant slug
        schema:
          type: string
      security:
      - bearer: []
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                type: array
                items:
                  type: string
        "401":
          description: Not signed in
          content:
            application/problem+json:
              schema:
                $ref: "#/components/schemas/ProblemDetails"
  "/tenants/{tenant}/billing/invoices/{id}":
    get:
      summary: Get the invoice
      operationId: invoice
      tags:
      - Billing
      parameters:
      - name: tenant
        in: path
        required: true
        description: Tenant slug
        schema:
          type: string
      - name: id
        in: path
        required: true
        schema:
          type: integer
          format: int64
          minimum: 0
      security: []
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                type: string
        "401":
          description: Not signed in
          content:
            application/problem+json:
              schema:
                $ref: "#/components/schemas/ProblemDetails"
components:
  securitySchemes:
    bearer:
      type: http
      scheme: bearer
  schemas:
    ProblemDetails:
      type: object
      description: Problem details (RFC 9457).
      properties:
        type:
          type: string
          format: uri-reference
          default: about:blank
          description: A URI reference that identifies the problem type.
        title:
          type: string
          description: A short summary of the problem type.
        status:
          type: integer
          format: int32
          minimum: 100
          maximum: 599
          description: The HTTP status code.
        detail:
          type: string
          description: An explanation specific to this occurrence.
        instance:
          type: string
          format: uri-reference
          description: A URI reference that identifies this occurrence.
