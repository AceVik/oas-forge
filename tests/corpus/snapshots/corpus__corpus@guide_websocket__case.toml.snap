              "schema": "syntax = \"proto3\";\n\npackage baylee.v1;\n\n// Every frame on the gateway socket.\nmessage Envelope {\n  uint64 sequence = 1;\n  oneof body {\n    Hello hello = 2;\n    Event event = 3;\n  }\n}\n\nmessage Hello {\n  string client = 1;\n}\n\nmessage Event {\n  string topic = 1;\n  bytes data = 2;\n}\n",
