{
  "asyncapi": {
    "document": {
      "asyncapi": "3.1.0",
      "channels": {
        "changes": {
          "address": "user/changes",
          "messages": {
            "ChangeAck": {
              "$ref": "#/components/messages/ChangeAck"
            },
            "UserChanged": {
              "$ref": "#/components/messages/UserChanged"
            }
          }
        },
        "heartbeat": {
          "address": "heartbeat",
          "messages": {
            "Heartbeat": {
              "$ref": "#/components/messages/Heartbeat"
            }
          }
        },
        "user_id_signedup": {
          "address": "user/{id}/signedup",
          "messages": {
            "UserSignedUp": {
              "$ref": "#/components/messages/UserSignedUp"
            }
          },
          "parameters": {
            "id": {}
          }
        }
      },
      "components": {
        "messages": {
          "ChangeAck": {
            "name": "ChangeAck",
            "payload": {
              "properties": {
                "ok": {
                  "type": "boolean"
                }
              },
              "type": "object"
            }
          },
          "Heartbeat": {
            "description": "Seconds since start",
            "name": "Heartbeat",
            "payload": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "UserChanged": {
            "name": "UserChanged",
            "payload": {
              "$ref": "#/components/schemas/Change"
            }
          },
          "UserSignedUp": {
            "description": "The new user",
            "name": "UserSignedUp",
            "payload": {
              "$ref": "#/components/schemas/User"
            }
          }
        },
        "schemas": {
          "Change": {
            "discriminator": "kind",
            "oneOf": [
              {
                "$ref": "#/components/schemas/ChangeRenamed"
              },
              {
                "$ref": "#/components/schemas/ChangeDeleted"
              }
            ],
            "type": "object"
          },
          "ChangeDeleted": {
            "properties": {
              "kind": {
                "description": "Discriminator: Deleted",
                "enum": [
                  "Deleted"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "ChangeRenamed": {
            "properties": {
              "kind": {
                "description": "Discriminator: Renamed",
                "enum": [
                  "Renamed"
                ],
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "name"
            ],
            "type": "object"
          },
          "User": {
            "properties": {
              "id": {
                "format": "int64",
                "minimum": 0,
                "type": "integer"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "position": {
                "additionalItems": false,
                "items": [
                  {
                    "format": "double",
                    "type": "number"
                  },
                  {
                    "format": "double",
                    "type": "number"
                  }
                ],
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              }
            },
            "required": [
              "id",
              "position"
            ],
            "type": "object"
          }
        }
      },
      "defaultContentType": "application/json",
      "info": {
        "description": "Events of the user service.",
        "title": "Events",
        "version": "1.0.0"
      },
      "operations": {
        "on_change_receive": {
          "action": "receive",
          "channel": {
            "$ref": "#/channels/changes"
          },
          "messages": [
            {
              "$ref": "#/channels/changes/messages/UserChanged"
            }
          ]
        },
        "on_change_send": {
          "action": "send",
          "channel": {
            "$ref": "#/channels/changes"
          },
          "messages": [
            {
              "$ref": "#/channels/changes/messages/ChangeAck"
            }
          ]
        },
        "publish_signup": {
          "action": "send",
          "channel": {
            "$ref": "#/channels/user_id_signedup"
          },
          "description": "More details about sign-ups.",
          "messages": [
            {
              "$ref": "#/channels/user_id_signedup/messages/UserSignedUp"
            }
          ],
          "summary": "A user signed up.",
          "tags": [
            {
              "name": "Users"
            }
          ]
        },
        "send_heartbeat": {
          "action": "send",
          "channel": {
            "$ref": "#/channels/heartbeat"
          },
          "messages": [
            {
              "$ref": "#/channels/heartbeat/messages/Heartbeat"
            }
          ]
        }
      },
      "servers": {
        "production": {
          "host": "broker.example.com",
          "protocol": "kafka"
        }
      }
    },
