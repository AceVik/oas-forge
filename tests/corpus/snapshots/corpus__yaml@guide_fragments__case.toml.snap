openapi: "3.1.0"
info:
  title: Admin
  version: "1.0.0"
paths:
  /audit:
    get:
      summary: List audit events
      operationId: audit
      parameters:
      - name: page
        in: query
        schema:
          type: integer
          minimum: 1
          default: 1
      - name: size
        in: query
        schema:
          type: integer
          minimum: 1
          maximum: 100
          default: 20
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                type: array
                items:
                  type: string
        "401":
          description: Not signed in
        "403":
          description: Requires the admin role
      security:
      - oidc:
        - admin
  /reports:
    get:
      summary: List reports
      responses:
        "200":
          description: The reports
        "401":
          description: Not signed in
        "403":
          description: Requires the auditor role
      security:
      - oidc:
        - auditor
components:
  securitySchemes:
    oidc:
      type: openIdConnect
      openIdConnectUrl: https://id.example.com/.well-known/openid-configuration
