# full output
openapi: "3.2.0"
info:
  title: Modern API
  version: "1.0.0"
paths:
  /search:
    query:
      operationId: search
      parameters:
      - name: filter
        in: querystring
        required: true
        description: Search filter
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: "#/components/schemas/Filter"
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                type: array
                items:
                  type: string
  /cache:
    additionalOperations:
      PURGE:
        operationId: purge
        responses:
          "204":
            description: Purged
  /events:
    get:
      operationId: events
      responses:
        "200":
          description: Server-sent events
          content:
            text/event-stream:
              itemSchema:
                $ref: "#/components/schemas/Event"
        "206":
          description: JSON Lines
          content:
            application/jsonl:
              itemSchema:
                $ref: "#/components/schemas/Event"
webhooks:
  orderCreated:
    post:
      operationId: order_created
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/Event"
        required: true
      responses:
        "200":
          description: Received
components:
  schemas:
    Event:
      type: object
      properties:
        kind:
          type: string
      required:
      - kind
    Filter:
      type: object
      properties:
        name:
          type:
          - string
          - "null"
