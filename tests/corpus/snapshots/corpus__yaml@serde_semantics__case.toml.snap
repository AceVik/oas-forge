---
source: tests/corpus/main.rs
expression: text
input_file: tests/corpus/cases/serde_semantics/case.toml
---
# full output
openapi: "3.1.0"
info:
  title: Corpus
  version: "1.0.0"
paths:
  /events:
    get:
      summary: List events
      operationId: events
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Paged_Event_User"
  /settings:
    get:
      summary: The settings
      operationId: settings
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Settings"
        "201":
          description: Created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Color"
        "202":
          description: Accepted
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Pair"
components:
  schemas:
    Color:
      type: string
      enum:
      - Crimson
      - Red
      oneOf:
      - const: Crimson
        description: The old name of red.
        deprecated: true
      - const: Red
    EventCreated_User:
      type: object
      properties:
        type:
          type: string
          enum:
          - Created
          description: "Discriminator: Created"
        item:
          $ref: "#/components/schemas/User"
      required:
      - type
      - item
    EventDeleted:
      type: object
      properties:
        type:
          type: string
          enum:
          - Deleted
          description: "Discriminator: Deleted"
        id:
          type: integer
          format: int64
          minimum: 0
      required:
      - type
      - id
    Event_User:
      type: object
      oneOf:
      - $ref: "#/components/schemas/EventCreated_User"
      - $ref: "#/components/schemas/EventDeleted"
      discriminator:
        propertyName: type
        mapping:
          Created: "#/components/schemas/EventCreated_User"
          Deleted: "#/components/schemas/EventDeleted"
      description: An event about any item.
    Level:
      type: integer
      enum:
      - 1
      - 3
    Page_Event_User:
      type: object
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/Wrapper_Event_User"
      required:
      - items
      description: One page of results.
    Paged_Event_User:
      $ref: "#/components/schemas/Page_Event_User"
    Pair:
      type: array
      prefixItems:
      - type: integer
        format: int32
        minimum: 0
        maximum: 255
      items: false
      minItems: 1
      maxItems: 1
    Settings:
      type: object
      properties:
        name:
          type: string
        changed:
          type:
          - integer
          - "null"
          format: int64
      required:
      - name
      - changed
      allOf:
      - $ref: "#/components/schemas/Wrapper_Level"
      unevaluatedProperties:
        type: string
    User:
      type: object
      properties:
        kind:
          type: string
          enum:
          - User
        id:
          type: integer
          format: int64
          minimum: 0
        user_name:
          type: string
      required:
      - kind
      - id
      - user_name
      additionalProperties: false
      description: A user.
    Wrapper_Event_User:
      type: object
      properties:
        value:
          $ref: "#/components/schemas/Event_User"
      required:
      - value
    Wrapper_Level:
      type: object
      properties:
        value:
          $ref: "#/components/schemas/Level"
      required:
      - value
