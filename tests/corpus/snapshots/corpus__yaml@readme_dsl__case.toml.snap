# full output
openapi: "3.1.0"
info:
  title: Corpus
  version: "1.0.0"
paths:
  /users:
    get:
      summary: List Users
      description: Returns a paginated list of users.
      operationId: list_users
      tags:
      - Users
      parameters:
      - name: page
        in: query
        required: false
        description: Page number
        schema:
          type: integer
          format: int64
          minimum: 0
          maximum: 4294967295
      responses:
        "200":
          description: List of users
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/User"
    post:
      operationId: create_user
      responses:
        "201":
          description: Created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/User"
        "200":
          description: List
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Page_User"
        "204":
          description: Deleted
        "400":
          description: Invalid Input
  "/users/{id}":
    get:
      operationId: get_user
      parameters:
      - name: id
        in: path
        required: true
        schema:
          type: integer
          format: int64
          minimum: 0
          maximum: 4294967295
        description: The unique ID
      responses:
        default:
          description: Default response
  /search:
    get:
      operationId: search
      parameters:
      - name: filter
        in: query
        required: false
        description: Filter by name
        schema:
          type: string
        deprecated: true
        example: Alice
      - name: X-Trace-ID
        in: header
        required: true
        description: Tracing ID
        schema:
          type: string
          format: uuid
      responses:
        default:
          description: Default response
  /users/create:
    post:
      operationId: create
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateRequest"
        required: true
      responses:
        default:
          description: Default response
  /protected:
    get:
      operationId: protected
      security:
      - oidc:
        - read
        - write
      - basic: []
      responses:
        default:
          description: Default response
  /complex:
    get:
      summary: "# You can inject raw parameters alongside DSL"
      operationId: complex_handler
      tags:
      - Items
      responses:
        default:
          description: Default response
components:
  schemas:
    CreateRequest:
      type: object
      properties:
        name:
          type: string
      required:
      - name
    Page_User:
      type: object
      properties:
        data:
          type: array
          items:
            $ref: "#/components/schemas/User"
      required:
      - data
    User:
      type: object
      properties:
        id:
          type: integer
          format: int64
          minimum: 0
          maximum: 4294967295
      required:
      - id
