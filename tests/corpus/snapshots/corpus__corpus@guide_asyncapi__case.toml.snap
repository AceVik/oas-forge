{
  "asyncapi": {
    "document": {
      "asyncapi": "3.0.0",
      "channels": {
        "orders": {
          "address": "order/{id}/events",
          "messages": {
            "OrderChanged": {
              "$ref": "#/components/messages/OrderChanged"
            }
          },
