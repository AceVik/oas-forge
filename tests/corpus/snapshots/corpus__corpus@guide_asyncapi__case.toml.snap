            "description": "An order.",
            "properties": {
              "id": {
                "format": "int64",
                "minimum": 0,
                "type": "integer"
              },
              "total_cents": {
                "format": "int64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "id",
              "total_cents"
            ],
            "type": "object"
          },
          "OrderEvent": {
            "description": "What changed.",
            "discriminator": "type",
            "oneOf": [
              {
                "$ref": "#/components/schemas/OrderEventPlaced"
              },
              {
                "$ref": "#/components/schemas/OrderEventCancelled"
              }
            ],
            "type": "object"
          },
          "OrderEventCancelled": {
            "properties": {
              "id": {
                "format": "int64",
                "minimum": 0,
                "type": "integer"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "description": "Discriminator: cancelled",
                "enum": [
                  "cancelled"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "id",
              "reason"
            ],
            "type": "object"
          },
          "OrderEventPlaced": {
            "properties": {
              "order": {
                "$ref": "#/components/schemas/Order"
              },
              "type": {
                "description": "Discriminator: placed",
                "enum": [
                  "placed"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "order"
            ],
            "type": "object"
          }
        }
      },
      "defaultContentType": "application/json",
      "info": {
        "title": "Order events",
        "version": "1.0.0"
      },
      "operations": {
        "on_payment": {
          "action": "receive",
          "channel": {
            "$ref": "#/channels/payments_confirmed"
          },
          "messages": [
            {
              "$ref": "#/channels/payments_confirmed/messages/PaymentConfirmed"
            }
          ],
          "summary": "Payment confirmations from the payment provider."
        },
        "publish_order_event": {
          "action": "send",
          "channel": {
            "$ref": "#/channels/orders"
          },
          "description": "Every change of an order, keyed by order id.",
          "messages": [
            {
              "$ref": "#/channels/orders/messages/OrderChanged"
            }
          ],
          "summary": "Order lifecycle",
          "tags": [
            {
              "name": "Orders"
            }
          ]
        }
      },
      "servers": {
        "production": {
          "host": "kafka.example.com:9092",
          "protocol": "kafka"
        }
      }
    },
